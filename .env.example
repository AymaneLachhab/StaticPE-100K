# Copier en `.env` et renseigner. Aucune valeur n est versionnee.
#
# VirusShare : liste de cles separees par des virgules. La collecte les fait
# tourner pour rester sous la limite de debit du depot.
VIRUSSHARE_API_KEYS=

# MalwareBazaar : sert a l attribution de famille, pas a la collecte.
MALWAREBAZAAR_API_KEY=

# Hybrid Analysis : interrogation par hachage uniquement, aucun envoi de
# fichier. Sert a la verification des candidats benins.
HYBRID_ANALYSIS_API_KEY=

# Facultatifs, pour completer les familles non couvertes par AVClass.
METADEFENDER_API_KEY=
VIRUSTOTAL_API_KEY=
